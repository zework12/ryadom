    <!-- Знак приложения: двое рядом — один «я», второй «тот, кто рядом». -->
    <LinearGradientBrush x:Key="Logo.Back" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1DAE91" Offset="0" />
        <GradientStop Color="#0A6657" Offset="1" />
    </LinearGradientBrush>
    <DrawingGroup x:Key="Logo.Drawing">
        <GeometryDrawing Brush="{StaticResource Logo.Back}">
            <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="0,0,64,64" RadiusX="15" RadiusY="15" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#E6FFFFFF">
            <GeometryDrawing.Geometry>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                        <CombinedGeometry GeometryCombineMode="Exclude">
                            <CombinedGeometry.Geometry1>
                                <EllipseGeometry Center="40.5,32" RadiusX="11.5" RadiusY="11.5" />
                            </CombinedGeometry.Geometry1>
                            <CombinedGeometry.Geometry2>
                                <EllipseGeometry Center="40.5,32" RadiusX="6.5" RadiusY="6.5" />
                            </CombinedGeometry.Geometry2>
                        </CombinedGeometry>
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <EllipseGeometry Center="23.5,32" RadiusX="14.5" RadiusY="14.5" />
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#FFFFFF">
            <GeometryDrawing.Geometry>
                <EllipseGeometry Center="23.5,32" RadiusX="11.5" RadiusY="11.5" />
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>
    <DrawingImage x:Key="Logo" Drawing="{StaticResource Logo.Drawing}" />
</ResourceDictionary>

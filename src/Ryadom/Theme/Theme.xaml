<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Ryadom.ViewModels"
                    xmlns:v="clr-namespace:Ryadom.Views">
    <!-- Единственный словарь, который подключает App.xaml: палитра, значки, стили и «модель → экран».
         Тёмную палитру (Palette.Dark.xaml) на время сеанса подмешивает MainShell. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Palette.Light.xaml" />
        <ResourceDictionary Source="Icons.xaml" />
        <ResourceDictionary Source="Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate DataType="{x:Type vm:StartViewModel}">
        <v:StartView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SetupViewModel}">
        <v:SetupView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:HostViewModel}">
        <v:HostView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:JoinViewModel}">
        <v:JoinView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SessionViewModel}">
        <v:SessionView />
    </DataTemplate>
</ResourceDictionary>

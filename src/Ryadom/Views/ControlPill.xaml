<UserControl x:Class="Ryadom.Views.ControlPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Ryadom.Theme"
             FontFamily="{StaticResource Font.Ui}" FontSize="14" Foreground="#F1F3F6"
             UseLayoutRounding="True" SnapsToDevicePixels="True" Focusable="False">
    <!-- Плашка «вашим компьютером управляют». Всегда тёмная: лежит поверх чужих окон любого цвета. -->
    <UserControl.Resources>
        <Style x:Key="Pill.Disconnect" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#E5534B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EC665F" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#CF4740" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#3A3F48" />
                    <Setter Property="Foreground" Value="#8A93A0" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,8,16,24">
        <Border CornerRadius="24" Background="#1D2026">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.4" />
            </Border.Effect>
        </Border>
        <Border x:Name="Body" CornerRadius="24" Height="48" Background="#1D2026" BorderBrush="#19C39A" BorderThickness="1.5"
                Padding="18,0,8,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="10" Height="10" VerticalAlignment="Center">
                    <Ellipse x:Name="Pulse" Fill="#19C39A" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform ScaleX="1.8" ScaleY="1.8" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Fill="#19C39A" />
                </Grid>
                <TextBlock Text="Вашим компьютером управляет" Margin="12,0,0,1" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ViewerName, TargetNullValue=помощник}" FontWeight="SemiBold" Margin="5,0,0,1" MaxWidth="200"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Text="·" Margin="8,0,8,1" VerticalAlignment="Center" Foreground="#8A93A0" />
                <TextBlock Text="{Binding DurationText}" MinWidth="40" Margin="0,0,0,1" VerticalAlignment="Center" Foreground="#B4BBC7"
                           Typography.NumeralAlignment="Tabular" />
                <Button Style="{StaticResource Pill.Disconnect}" Command="{Binding DisconnectCommand}" Content="Отключить" Margin="12,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

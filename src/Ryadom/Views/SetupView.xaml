<UserControl x:Class="Ryadom.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Ryadom.Theme"
             xmlns:v="clr-namespace:Ryadom.Views"
             Focusable="False">
    <Grid>
        <!-- ── Выбор (он же виден под вопросом об удалении) ── -->
        <Grid Visibility="{Binding State, Converter={StaticResource EqVis}, ConverterParameter=Choose|ConfirmUninstall}">
            <!-- Ещё не установлено -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,0,32,32" MaxWidth="520"
                        Visibility="{Binding IsInstalled, Converter={StaticResource Vis}, ConverterParameter=!}">
                <Image Source="{StaticResource Logo}" Width="72" Height="72" HorizontalAlignment="Center" />
                <TextBlock Text="Рядом" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                <TextBlock Text="Близкий человек видит ваш экран и помогает, как будто сидит рядом." Style="{StaticResource Text.Sub}"
                           MaxWidth="400" Margin="0,8,0,0" />
                <Button Style="{StaticResource Btn.Primary.Large}" Command="{Binding InstallCommand}" Content="Установить" IsDefault="True"
                        Width="320" HorizontalAlignment="Center" Margin="0,32,0,0" />
                <TextBlock Text="{Binding ThisVersion, StringFormat='Версия {0}'}" Style="{StaticResource Text.Caption}"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />
            </StackPanel>

            <!-- Уже установлено -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,0,32,32" MaxWidth="520"
                        Visibility="{Binding IsInstalled, Converter={StaticResource Vis}}">
                <Image Source="{StaticResource Logo}" Width="72" Height="72" HorizontalAlignment="Center" />
                <TextBlock Text="«Рядом» уже установлено" Style="{StaticResource Text.H1}" Margin="0,20,0,0" />
                <TextBlock Text="{Binding InstalledVersion, StringFormat='Версия {0}'}" Style="{StaticResource Text.Sub}" Margin="0,4,0,0"
                           Visibility="{Binding InstalledVersion, Converter={StaticResource Vis}}" />
                <Button Style="{StaticResource Btn.Primary.Large}" Command="{Binding OpenCommand}" Content="Открыть" IsDefault="True"
                        Width="320" HorizontalAlignment="Center" Margin="0,32,0,0" />
                <Grid Width="320" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource Btn.Secondary}" Command="{Binding ReinstallCommand}" Content="Переустановить" HorizontalAlignment="Stretch" />
                    <Button Grid.Column="2" Style="{StaticResource Btn.DangerGhost}" Command="{Binding UninstallCommand}" Content="Удалить" />
                </Grid>
                <TextBlock Text="{Binding ThisVersion, StringFormat='«Переустановить» поставит версию {0}'}" Style="{StaticResource Text.Caption}"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />
            </StackPanel>
        </Grid>

        <!-- ── Устанавливаем / удаляем ── -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,0,32,32" MaxWidth="520"
                    Visibility="{Binding State, Converter={StaticResource EqVis}, ConverterParameter=Working}">
            <Control Style="{StaticResource Spinner}" Width="40" Height="40" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.H1}" Margin="0,24,0,0" />
            <TextBlock Text="Это займёт несколько секунд" Style="{StaticResource Text.Sub}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- ── Удалено ── -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,0,32,32" MaxWidth="520"
                    Visibility="{Binding State, Converter={StaticResource EqVis}, ConverterParameter=Uninstalled}">
            <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource B.AccentSoft}" HorizontalAlignment="Center">
                <t:IconView Data="{StaticResource Icon.Check}" Width="32" Height="32" Stroke="2.5" Foreground="{DynamicResource B.AccentText}" />
            </Border>
            <TextBlock Text="«Рядом» удалено" Style="{StaticResource Text.H1}" Margin="0,24,0,0" />
            <TextBlock Text="Скачать снова можно в любой момент" Style="{StaticResource Text.Sub}" Margin="0,4,0,0" />
            <Button Style="{StaticResource Btn.Primary.Large}" Command="{Binding CloseCommand}" Content="Закрыть" IsDefault="True"
                    Width="240" HorizontalAlignment="Center" Margin="0,32,0,0" />
        </StackPanel>

        <!-- ── Не получилось ── -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,0,32,32" MaxWidth="520"
                    Visibility="{Binding State, Converter={StaticResource EqVis}, ConverterParameter=Error}">
            <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource B.DangerSoft}" HorizontalAlignment="Center">
                <t:IconView Data="{StaticResource Icon.Alert}" Width="32" Height="32" Stroke="2" Foreground="{DynamicResource B.DangerText}" />
            </Border>
            <TextBlock Text="Не получилось" Style="{StaticResource Text.H1}" Margin="0,24,0,0" />
            <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Sub}" Margin="0,4,0,0" />
            <Button Style="{StaticResource Btn.Secondary.Large}" Command="{Binding CloseCommand}" Content="Закрыть" IsDefault="True"
                    Width="240" HorizontalAlignment="Center" Margin="0,32,0,0" />
        </StackPanel>

        <!-- ── Вопрос об удалении ── -->
        <v:UninstallQuestion ConfirmCommand="{Binding ConfirmUninstallCommand}" CancelCommand="{Binding CancelCommand}"
                             Visibility="{Binding State, Converter={StaticResource EqVis}, ConverterParameter=ConfirmUninstall}" />
    </Grid>
</UserControl>

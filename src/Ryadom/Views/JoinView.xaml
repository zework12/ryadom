<UserControl x:Class="Ryadom.Views.JoinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Ryadom.Theme"
             Focusable="False">
    <Grid>
        <!-- ── Форма: код и имя ── -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400" Margin="32,8,32,16"
                    Visibility="{Binding State, Converter={StaticResource EqVis}, ConverterParameter=Idle|Denied|Error}">
            <TextBlock Text="Подключиться" Style="{StaticResource Text.H1}" />
            <TextBlock Text="Попросите человека продиктовать код с его экрана" Style="{StaticResource Text.Sub}" Margin="0,4,0,0" />

            <TextBlock Text="Код" Style="{StaticResource Text.Label}" Margin="0,24,0,8" />
            <TextBox x:Name="CodeBox" Style="{StaticResource Input.Code}" t:Ui.Placeholder="000 000 000"
                     InputScope="Number" MaxLength="16"
                     Text="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextChanged="OnCodeChanged" PreviewTextInput="OnCodePreviewInput" />

            <TextBlock Text="Ваше имя" Style="{StaticResource Text.Label}" Margin="0,20,0,8" />
            <TextBox x:Name="NameBox" Style="{StaticResource Input}" t:Ui.Placeholder="Например, Миша" MaxLength="24"
                     Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Его увидит человек, когда будет разрешать подключение" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />

            <!-- Отказ или ошибка -->
            <Border CornerRadius="10" Padding="14,12" Margin="0,20,0,0" Background="{DynamicResource B.DangerSoft}"
                    Visibility="{Binding State, Converter={StaticResource EqVis}, ConverterParameter=Denied|Error}">
                <Grid TextElement.Foreground="{DynamicResource B.DangerText}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <t:IconView Data="{StaticResource Icon.Alert}" Width="18" Height="18" Margin="0,2,10,0" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" FontSize="15" TextWrapping="Wrap" Text="Человек отклонил подключение"
                               Visibility="{Binding State, Converter={StaticResource EqVis}, ConverterParameter=Denied}" />
                    <TextBlock Grid.Column="1" FontSize="15" TextWrapping="Wrap" Text="{Binding ErrorText}"
                               Visibility="{Binding State, Converter={StaticResource EqVis}, ConverterParameter=Error}" />
                </Grid>
            </Border>

            <Button Style="{StaticResource Btn.Primary.Large}" Command="{Binding ConnectCommand}" Content="Подключиться"
                    IsDefault="True" Margin="0,24,0,0" />
        </StackPanel>

        <!-- ── Подключаемся ── -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,0,32,32" MaxWidth="520"
                    Visibility="{Binding State, Converter={StaticResource EqVis}, ConverterParameter=Connecting}">
            <Control Style="{StaticResource Spinner}" Width="40" Height="40" />
            <TextBlock Text="Подключаемся…" Style="{StaticResource Text.H1}" Margin="0,24,0,0" />
            <TextBlock Text="Это займёт несколько секунд" Style="{StaticResource Text.Sub}" Margin="0,4,0,0" />
            <Button Style="{StaticResource Btn.Secondary}" Command="{Binding CancelCommand}" Content="Отмена"
                    Width="160" HorizontalAlignment="Center" Margin="0,32,0,0" />
        </StackPanel>

        <!-- ── Ждём «Разрешить» ── -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,0,32,32" MaxWidth="520"
                    Visibility="{Binding State, Converter={StaticResource EqVis}, ConverterParameter=WaitingApproval}">
            <Control Style="{StaticResource Spinner}" Width="40" Height="40" />
            <TextBlock Text="Ждём, пока человек на той стороне нажмёт «Разрешить»" Style="{StaticResource Text.H1}" Margin="0,24,0,0" />
            <TextBlock Text="У него на экране появился вопрос. Подскажите, что нужно нажать зелёную кнопку."
                       Style="{StaticResource Text.Sub}" Margin="0,8,0,0" />
            <Button Style="{StaticResource Btn.Secondary}" Command="{Binding CancelCommand}" Content="Отмена"
                    Width="160" HorizontalAlignment="Center" Margin="0,32,0,0" />
        </StackPanel>

        <!-- ── «Назад» ── -->
        <Button Style="{StaticResource Btn.Ghost}" Command="{Binding BackCommand}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,8,0,0">
            <StackPanel Orientation="Horizontal">
                <t:IconView Data="{StaticResource Icon.ArrowLeft}" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="Назад" Margin="8,0,0,1" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>

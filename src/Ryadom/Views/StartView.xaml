<UserControl x:Class="Ryadom.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Ryadom.Theme"
             xmlns:v="clr-namespace:Ryadom.Views"
             Focusable="False">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,0,32,32">
            <Image Source="{StaticResource Logo}" Width="64" Height="64" HorizontalAlignment="Center" />
            <TextBlock Text="Рядом" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
            <TextBlock Text="Помощь близкому человеку на расстоянии" Style="{StaticResource Text.Sub}" Margin="0,4,0,40" />

            <Grid MaxWidth="720">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="348" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" MaxWidth="348" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource Btn.Card}" Command="{Binding NeedHelpCommand}" Width="348" Height="208">
                    <StackPanel>
                        <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource B.AccentSoft}" HorizontalAlignment="Left">
                            <t:IconView Data="{StaticResource Icon.Heart}" Width="28" Height="28" Stroke="2" Foreground="{DynamicResource B.AccentText}" />
                        </Border>
                        <TextBlock Text="Мне нужна помощь" FontSize="22" FontWeight="SemiBold" Margin="0,24,0,0" />
                        <TextBlock Text="Покажу свой экран и получу код" FontSize="16" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource B.Text2}" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource Btn.Card}" Command="{Binding HelpOtherCommand}" Width="348" Height="208">
                    <StackPanel>
                        <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource B.AccentSoft}" HorizontalAlignment="Left">
                            <t:IconView Data="{StaticResource Icon.Pointer}" Width="28" Height="28" Stroke="2" Foreground="{DynamicResource B.AccentText}" />
                        </Border>
                        <TextBlock Text="Я помогаю" FontSize="22" FontWeight="SemiBold" Margin="0,24,0,0" />
                        <TextBlock Text="Подключусь по коду" FontSize="16" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource B.Text2}" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <v:UninstallQuestion ConfirmCommand="{Binding ConfirmUninstallCommand}" CancelCommand="{Binding CancelUninstallCommand}"
                             Visibility="{Binding ConfirmingUninstall, Converter={StaticResource Vis}}" />
    </Grid>
</UserControl>

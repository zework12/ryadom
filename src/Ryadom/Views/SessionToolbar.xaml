<UserControl x:Class="Ryadom.Views.SessionToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Ryadom.Theme"
             Focusable="False" Height="48">
    <UserControl.Resources>
        <Style x:Key="ComboItem.Quality" TargetType="ComboBoxItem" BasedOn="{StaticResource ComboItem}">
            <Setter Property="t:Ui.Subtitle" Value="{Binding Hint}" />
        </Style>
        <Style x:Key="ComboItem.Monitor" TargetType="ComboBoxItem" BasedOn="{StaticResource ComboItem}">
            <Setter Property="t:Ui.Subtitle">
                <Setter.Value>
                    <MultiBinding StringFormat="{}{0}×{1}">
                        <Binding Path="Width" />
                        <Binding Path="Height" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Слева: кому помогаем и настройки картинки -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <t:IconView Data="{StaticResource Icon.Monitor}" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource B.Text3}" />
            <TextBlock x:Name="PeerText" Text="{Binding PeerName}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,1" MaxWidth="200"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding PeerName}" />
            <Rectangle Width="1" Height="20" Margin="12,0" Fill="{DynamicResource B.Border}" />

            <ComboBox x:Name="FpsCombo" Style="{StaticResource Combo}" ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding SelectedFps, Mode=TwoWay}"
                      ToolTip="Плавность картинки" />
            <ComboBox x:Name="QualityCombo" Style="{StaticResource Combo}" Margin="8,0,0,0" Tag="Качество"
                      ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality, Mode=TwoWay}"
                      ItemContainerStyle="{StaticResource ComboItem.Quality}" ToolTip="{Binding SelectedQuality.Hint}" />
            <ComboBox x:Name="MonitorCombo" Style="{StaticResource Combo}" Margin="8,0,0,0"
                      ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                      ItemContainerStyle="{StaticResource ComboItem.Monitor}" ToolTip="Какой экран показывать"
                      Visibility="{Binding Monitors, Converter={StaticResource ManyVis}}" />

            <Rectangle Width="1" Height="20" Margin="12,0" Fill="{DynamicResource B.Border}" />

            <ToggleButton x:Name="ControlToggle" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding ControlEnabled, Mode=TwoWay}"
                          ToolTip="Включено — ваши мышь и клавиатура работают на том компьютере">
                <Grid x:Name="ControlLabel" Margin="8,0,0,1">
                    <!-- Невидимая строка держит ширину, чтобы кнопка не прыгала при переключении -->
                    <TextBlock Text="Только смотреть" Visibility="Hidden" />
                    <TextBlock Text="Управлять" Visibility="{Binding ControlEnabled, Converter={StaticResource Vis}}" />
                    <TextBlock Text="Только смотреть" Foreground="{DynamicResource B.Text2}"
                               Visibility="{Binding ControlEnabled, Converter={StaticResource Vis}, ConverterParameter=!}" />
                </Grid>
            </ToggleButton>

            <ToggleButton x:Name="KeysToggle" Style="{StaticResource Btn.Tool}" Margin="8,0,0,0" ToolTip="Нажать сочетание клавиш на том компьютере">
                <StackPanel Orientation="Horizontal">
                    <t:IconView Data="{StaticResource Icon.Keyboard}" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock x:Name="KeysLabel" Text="Клавиши" Margin="8,0,0,1" VerticalAlignment="Center" />
                    <t:IconView Data="{StaticResource Icon.ChevronDown}" Width="14" Height="14" Margin="6,1,-4,0" VerticalAlignment="Center"
                                Foreground="{DynamicResource B.Text3}" />
                </StackPanel>
            </ToggleButton>
            <Popup x:Name="KeysPopup" PlacementTarget="{Binding ElementName=KeysToggle}" Placement="Bottom" HorizontalOffset="-12"
                   AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade" Focusable="False"
                   IsOpen="{Binding IsChecked, ElementName=KeysToggle, Mode=TwoWay}">
                <Grid x:Name="KeysMenu" Margin="12,4,12,20" MinWidth="280">
                    <Border CornerRadius="10" Background="{DynamicResource B.Popup}">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.22" />
                        </Border.Effect>
                    </Border>
                    <Border CornerRadius="10" Background="{DynamicResource B.Popup}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" Padding="4">
                        <StackPanel>
                            <Button Style="{StaticResource Btn.MenuItem}" Command="{Binding SendKeysCommand}" CommandParameter="taskmgr" Click="OnKeysItemClick">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="Ctrl+Shift+Esc" FontSize="12" Margin="24,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource B.Text3}" />
                                    <TextBlock Text="Диспетчер задач" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.MenuItem}" Command="{Binding SendKeysCommand}" CommandParameter="run" Click="OnKeysItemClick">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="Win+R" FontSize="12" Margin="24,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource B.Text3}" />
                                    <TextBlock Text="Выполнить" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.MenuItem}" Command="{Binding SendKeysCommand}" CommandParameter="win" Click="OnKeysItemClick">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="Win" FontSize="12" Margin="24,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource B.Text3}" />
                                    <TextBlock Text="Пуск" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.MenuItem}" Command="{Binding SendKeysCommand}" CommandParameter="alttab" Click="OnKeysItemClick">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="Alt+Tab" FontSize="12" Margin="24,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource B.Text3}" />
                                    <TextBlock Text="Переключить окно" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.MenuItem}" Command="{Binding SendKeysCommand}" CommandParameter="lang" Click="OnKeysItemClick">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="Alt+Shift" FontSize="12" Margin="24,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource B.Text3}" />
                                    <TextBlock Text="Сменить язык" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Popup>
        </StackPanel>

        <!-- Справа: связь, во весь экран, отключиться -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel x:Name="LinkPanel" Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent" Margin="12,0,0,0">
                <StackPanel.ToolTip>
                    <ToolTip>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Отличная связь" Visibility="{Binding Quality, Converter={StaticResource EqVis}, ConverterParameter=Excellent}" />
                            <TextBlock FontWeight="SemiBold" Text="Хорошая связь" Visibility="{Binding Quality, Converter={StaticResource EqVis}, ConverterParameter=Good}" />
                            <TextBlock FontWeight="SemiBold" Text="Слабая связь" Visibility="{Binding Quality, Converter={StaticResource EqVis}, ConverterParameter=Poor}" />
                            <TextBlock FontWeight="SemiBold" Text="Нет связи" Visibility="{Binding Quality, Converter={StaticResource EqVis}, ConverterParameter=Lost}" />
                            <TextBlock Margin="0,2,0,0">
                                <Run Text="{Binding ActualFps, Mode=OneWay, StringFormat='{}{0:0} кадров в секунду'}" /><LineBreak />
                                <Run Text="{Binding PingMs, Mode=OneWay, StringFormat='задержка {0} мс'}" /><LineBreak />
                                <Run Text="{Binding ResolutionText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </ToolTip>
                </StackPanel.ToolTip>
                <t:LinkBars Quality="{Binding Quality}" VerticalAlignment="Center"
                            GoodBrush="{DynamicResource B.Good}" PoorBrush="{DynamicResource B.Poor}"
                            LostBrush="{DynamicResource B.Danger}" OffBrush="{DynamicResource B.BorderStrong}" />
                <Grid x:Name="StatsHost" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,1"
                            TextElement.FontSize="12" TextElement.Foreground="{DynamicResource B.Text2}"
                            Visibility="{Binding Quality, Converter={StaticResource EqVis}, ConverterParameter=!Lost}">
                    <TextBlock Typography.NumeralAlignment="Tabular" Text="{Binding ActualFps, StringFormat='{}{0:0} к/с'}" />
                    <TextBlock Typography.NumeralAlignment="Tabular" Text="{Binding PingMs, StringFormat='  ·  {0} мс'}" />
                    <TextBlock x:Name="ResolutionText" Typography.NumeralAlignment="Tabular" Text="{Binding ResolutionText, StringFormat='  ·  {0}'}" />
                </StackPanel>
                <TextBlock Text="нет связи" FontSize="12" Margin="8,0,0,1" VerticalAlignment="Center"
                           Foreground="{DynamicResource B.DangerText}"
                           Visibility="{Binding Quality, Converter={StaticResource EqVis}, ConverterParameter=Lost}" />
                </Grid>
            </StackPanel>

            <Rectangle Width="1" Height="20" Margin="12,0" Fill="{DynamicResource B.Border}" />

            <Button x:Name="FullscreenButton" Style="{StaticResource Btn.Tool}" Command="{Binding ToggleFullscreenCommand}">
                <Grid>
                    <t:IconView Data="{StaticResource Icon.Expand}" Width="16" Height="16"
                                Visibility="{Binding IsFullscreen, Converter={StaticResource Vis}, ConverterParameter=!}" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsFullscreen, Converter={StaticResource Vis}}">
                        <t:IconView Data="{StaticResource Icon.Shrink}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="В окно" Margin="8,0,0,1" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Button.ToolTip>
                    <ToolTip>
                        <Grid>
                            <TextBlock Text="Во весь экран" Visibility="{Binding IsFullscreen, Converter={StaticResource Vis}, ConverterParameter=!}" />
                            <TextBlock Text="Выйти из полноэкранного режима" Visibility="{Binding IsFullscreen, Converter={StaticResource Vis}}" />
                        </Grid>
                    </ToolTip>
                </Button.ToolTip>
            </Button>

            <Button Style="{StaticResource Btn.ToolDanger}" Command="{Binding DisconnectCommand}" Margin="8,0,0,0" ToolTip="Закончить помощь">
                <StackPanel Orientation="Horizontal">
                    <t:IconView Data="{StaticResource Icon.Power}" Width="16" Height="16" Stroke="1.75" VerticalAlignment="Center" />
                    <TextBlock x:Name="DisconnectLabel" Text="Отключиться" Margin="8,0,0,1" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>

<UserControl x:Class="Ryadom.Views.SessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Ryadom.Theme"
             xmlns:v="clr-namespace:Ryadom.Views"
             Focusable="False">
    <!-- Картинка — отдельное окно Direct3D: поверх неё WPF рисовать не может.
         Поэтому панель и полоса «связь прервалась» стоят НАД картинкой отдельными строками,
         а в полноэкранном режиме панель и сообщения живут во всплывающих окнах (Popup). -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="ToolbarRow" Background="{DynamicResource B.Surface}" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0"
                Visibility="{Binding IsFullscreen, Converter={StaticResource Vis}, ConverterParameter=!}">
            <v:SessionToolbar x:Name="Toolbar" />
        </Border>

        <Border Grid.Row="1" Height="40" Background="{DynamicResource B.WarnSoft}"
                Visibility="{Binding IsReconnecting, Converter={StaticResource Vis}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Control Style="{StaticResource Spinner}" Width="16" Height="16" VerticalAlignment="Center"
                         Foreground="{DynamicResource B.WarnText}" BorderBrush="#33808080" />
                <TextBlock Text="Связь прервалась, восстанавливаем…" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center"
                           Foreground="{DynamicResource B.WarnText}" />
            </StackPanel>
        </Border>

        <Grid x:Name="VideoArea" Grid.Row="2" Background="#0B0C0E" ClipToBounds="True">
            <ContentPresenter Content="{Binding Video}" Visibility="{Binding HasVideo, Converter={StaticResource Vis}}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasVideo}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Video}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Control Style="{StaticResource Spinner}" Width="40" Height="40" />
                <TextBlock Text="Ждём картинку…" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0"
                           Foreground="{DynamicResource B.Text}" />
                <TextBlock Text="Экран появится через пару секунд" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0"
                           Foreground="{DynamicResource B.Text3}" />
            </StackPanel>
        </Grid>

        <!-- Панель полноэкранного режима: выезжает сверху по центру -->
        <Popup x:Name="BarPopup" PlacementTarget="{Binding ElementName=Root}" Placement="Custom" AllowsTransparency="True"
               StaysOpen="True" Focusable="False" PopupAnimation="Slide">
            <Grid x:Name="BarHost" Margin="16,8,16,24">
                <Border CornerRadius="12" Background="{DynamicResource B.Surface}">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.35" />
                    </Border.Effect>
                </Border>
                <Border CornerRadius="12" Background="{DynamicResource B.Surface}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
                    <v:SessionToolbar x:Name="BarToolbar" />
                </Border>
            </Grid>
        </Popup>

        <!-- Короткое сообщение: снизу по центру картинки -->
        <Popup x:Name="NoticePopup" PlacementTarget="{Binding ElementName=VideoArea}" Placement="Custom" AllowsTransparency="True"
               StaysOpen="True" Focusable="False" PopupAnimation="Fade" IsHitTestVisible="False">
            <Grid x:Name="NoticeHost" Margin="16,8,16,24">
                <Border CornerRadius="20" Background="#F01D2026">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.35" />
                    </Border.Effect>
                </Border>
                <Border CornerRadius="20" Background="#1D2026" BorderBrush="#414854" BorderThickness="1" Height="40" Padding="14,0,18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <t:IconView Data="{StaticResource Icon.Check}" Width="16" Height="16" Stroke="2" VerticalAlignment="Center" Foreground="#42D4B4" />
                        <TextBlock x:Name="NoticeText" FontSize="14" Margin="10,0,0,1" VerticalAlignment="Center" Foreground="#F1F3F6" />
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</UserControl>

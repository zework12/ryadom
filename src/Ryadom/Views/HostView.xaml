<UserControl x:Class="Ryadom.Views.HostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Ryadom.Theme"
             Focusable="False">
    <Grid>
        <!-- ── Получаем код ── -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,0,32,32"
                    Visibility="{Binding State, Converter={StaticResource EqVis}, ConverterParameter=Preparing}">
            <Control Style="{StaticResource Spinner}" Width="40" Height="40" />
            <TextBlock Text="Получаем код…" Style="{StaticResource Text.H1}" Margin="0,24,0,0" />
            <TextBlock Text="Это займёт несколько секунд" Style="{StaticResource Text.Sub}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- ── Код готов ── -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,0,32,32"
                    Visibility="{Binding State, Converter={StaticResource EqVis}, ConverterParameter=Waiting}">
            <TextBlock Text="Продиктуйте этот код тому, кто помогает" Style="{StaticResource Text.H1}" />
            <Grid Margin="0,24,0,0" HorizontalAlignment="Center">
                <Border CornerRadius="16" Background="{DynamicResource B.Surface}">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource C.Shadow}" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.08" />
                    </Border.Effect>
                </Border>
                <Border CornerRadius="16" Background="{DynamicResource B.Surface}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                        Padding="40,20,40,24">
                    <ItemsControl ItemsSource="{Binding Code, Converter={StaticResource CodeGroups}}" Focusable="False" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}" Margin="14,0" Focusable="False" IsTabStop="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Width="40" TextAlignment="Center" FontSize="60" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource B.Text}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>

            <Button Style="{StaticResource Btn.Secondary}" Command="{Binding CopyCodeCommand}" HorizontalAlignment="Center" MinWidth="200" Margin="0,24,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Visibility="{Binding CodeCopied, Converter={StaticResource Vis}, ConverterParameter=!}">
                        <t:IconView Data="{StaticResource Icon.Copy}" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Text="Скопировать" Margin="8,0,0,1" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" TextElement.Foreground="{DynamicResource B.AccentText}"
                                Visibility="{Binding CodeCopied, Converter={StaticResource Vis}}">
                        <t:IconView Data="{StaticResource Icon.Check}" Width="18" Height="18" Stroke="2" VerticalAlignment="Center" />
                        <TextBlock Text="Скопировано" Margin="8,0,0,1" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Button>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
                <Control Style="{StaticResource Spinner}" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock Text="Ждём, когда помощник введёт код" FontSize="15" Margin="8,0,0,1" VerticalAlignment="Center"
                           Foreground="{DynamicResource B.Text2}" />
            </StackPanel>
        </StackPanel>

        <!-- ── Разрешить? ── -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,0,32,32" MaxWidth="640"
                    Visibility="{Binding State, Converter={StaticResource EqVis}, ConverterParameter=Asking}">
            <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource B.AccentSoft}" HorizontalAlignment="Center">
                <TextBlock Text="{Binding ViewerName, Converter={StaticResource Initial}}" FontSize="30" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"
                           Foreground="{DynamicResource B.AccentText}" />
            </Border>
            <TextBlock Style="{StaticResource Text.H1}" Margin="0,24,0,0">
                <Run Text="{Binding ViewerName, Mode=OneWay, TargetNullValue=Помощник}" /><Run Text=" хочет подключиться к вашему компьютеру" />
            </TextBlock>
            <TextBlock Style="{StaticResource Text.Sub}" Margin="0,12,0,0" MaxWidth="480"
                       Text="Этот человек увидит ваш экран и сможет управлять мышью и клавиатурой. Разрешайте, только если знаете его." />
            <Grid Margin="0,32,0,0" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource Btn.Secondary.Large}" Command="{Binding DenyCommand}" Content="Отклонить" />
                <Button Grid.Column="2" Style="{StaticResource Btn.Primary.Large}" Command="{Binding AllowCommand}" Content="Разрешить" />
            </Grid>
        </StackPanel>

        <!-- ── Идёт помощь ── -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,0,32,32" MaxWidth="520"
                    Visibility="{Binding State, Converter={StaticResource EqVis}, ConverterParameter=Connected}">
            <Border HorizontalAlignment="Center" CornerRadius="14" Height="28" Padding="10,0,12,0" Background="{DynamicResource B.AccentSoft}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource B.Good}" VerticalAlignment="Center" />
                    <TextBlock Text="Идёт помощь" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,1" VerticalAlignment="Center"
                               Foreground="{DynamicResource B.AccentText}" />
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Text.H1}" Margin="0,20,0,0">
                <Run Text="{Binding ViewerName, Mode=OneWay, TargetNullValue=Помощник}" /><Run Text=" видит ваш экран и управляет им" />
            </TextBlock>
            <TextBlock Text="{Binding DurationText}" FontSize="48" FontWeight="Light" HorizontalAlignment="Center" Margin="0,12,0,0"
                       Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource B.Text2}" />
            <Button Style="{StaticResource Btn.Danger.Large}" Command="{Binding DisconnectCommand}" Width="260" HorizontalAlignment="Center" Margin="0,24,0,0">
                <StackPanel Orientation="Horizontal">
                    <t:IconView Data="{StaticResource Icon.Power}" Width="20" Height="20" Stroke="2" VerticalAlignment="Center" />
                    <TextBlock Text="Отключить" Margin="10,0,0,1" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Style="{StaticResource Text.Sub}" FontSize="14" Margin="0,16,0,0"
                       Text="Нажмите, если хотите сразу прекратить помощь" />
        </StackPanel>

        <!-- ── Связь прервалась ── -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,0,32,32" MaxWidth="520"
                    Visibility="{Binding State, Converter={StaticResource EqVis}, ConverterParameter=Reconnecting}">
            <Control Style="{StaticResource Spinner}" Width="40" Height="40" Foreground="{DynamicResource B.Poor}" />
            <TextBlock Text="Связь прервалась, восстанавливаем…" Style="{StaticResource Text.H1}" Margin="0,24,0,0" />
            <TextBlock Text="Ничего нажимать не нужно" Style="{StaticResource Text.Sub}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- ── Не получилось ── -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,0,32,32" MaxWidth="520"
                    Visibility="{Binding State, Converter={StaticResource EqVis}, ConverterParameter=Error}">
            <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource B.DangerSoft}" HorizontalAlignment="Center">
                <t:IconView Data="{StaticResource Icon.Alert}" Width="32" Height="32" Stroke="2" Foreground="{DynamicResource B.DangerText}" />
            </Border>
            <TextBlock Text="Не получилось" Style="{StaticResource Text.H1}" Margin="0,24,0,0" />
            <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Sub}" Margin="0,4,0,0" />
            <Button Style="{StaticResource Btn.Primary.Large}" Command="{Binding RetryCommand}" Width="260" HorizontalAlignment="Center" Margin="0,32,0,0">
                <StackPanel Orientation="Horizontal">
                    <t:IconView Data="{StaticResource Icon.Refresh}" Width="20" Height="20" Stroke="2" VerticalAlignment="Center" />
                    <TextBlock Text="Попробовать снова" Margin="10,0,0,1" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- ── «Назад» — везде, кроме идущей помощи ── -->
        <Button Style="{StaticResource Btn.Ghost}" Command="{Binding BackCommand}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,8,0,0"
                Visibility="{Binding State, Converter={StaticResource EqVis}, ConverterParameter=!Connected}">
            <StackPanel Orientation="Horizontal">
                <t:IconView Data="{StaticResource Icon.ArrowLeft}" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="Назад" Margin="8,0,0,1" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- ── Без прав администратора ── -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,16"
                    Visibility="{Binding IsElevated, Converter={StaticResource Vis}, ConverterParameter=!}">
            <t:IconView Data="{StaticResource Icon.Shield}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{DynamicResource B.Text3}" />
            <TextBlock Text="Окна с щитом (настройки системы) помощник двигать не сможет" Style="{StaticResource Text.Caption}"
                       Margin="8,0,0,1" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
